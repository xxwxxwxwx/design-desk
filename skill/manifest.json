{
  "schema_version": 1,
  "name": "create-fantuan-xiaohongshu-recruitment-poster",
  "version": "1.2.0",
  "input": {
    "reference_images": {"min": 1, "max": 9, "types": ["image/png", "image/jpeg", "image/webp"]},
    "merchant_logo": {"separate_asset": true, "required_when": "overlay_mode=co_brand"},
    "overlay_modes": ["co_brand", "fantuan_only"]
  },
  "output": {"count": 1, "width": 1080, "height": 1440, "format": "PNG"},
  "execution": [
    "generate_central_creative",
    "crop_background_buffers",
    "extend_vertical_background",
    "compose_fixed_overlay",
    "validate_output"
  ]
}

